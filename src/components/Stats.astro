---
import { profile, skills } from '../data/profile';
interface Props {
  projectCount: number;
  stars: number;
}
const { projectCount, stars } = Astro.props;
const techCount = skills.reduce((n, g) => n + g.items.length, 0);
const stats: [number, string, string][] = [
  [projectCount, '', 'projects & experiments'],
  [techCount, '', 'technologies'],
  // Show stars only once there are enough to brag about.
  stars >= 10 ? [stars, '', 'github stars'] : [profile.interests.length, '', 'focus areas'],
  [9999, '+', 'cups of coffee'],
];
---

<div class="mx-auto max-w-6xl px-5 sm:px-8">
  <dl class="reveal grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-4">
    {
      stats.map(([n, suffix, label]) => (
        <div class="spot flex flex-col bg-panel/90 px-5 py-7 text-center">
          <dt class="order-2 mt-1 text-xs tracking-wider text-muted uppercase">{label}</dt>
          <dd class="text-3xl font-bold text-accent glow sm:text-4xl">
            <span data-count={n}>{n}</span>
            {suffix}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
