---
interface Props {
  id: string;
  index: string;
  cmd: string;
  title: string;
  subtitle?: string;
  class?: string;
}
const { id, index, cmd, title, subtitle, class: cls = '' } = Astro.props;
---

<section id={id} class:list={['mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-28', cls]} aria-labelledby={`${id}-title`}>
  <header class="reveal mb-10 sm:mb-14">
    <p class="mb-3 text-sm text-muted">
      <span class="text-accent">{index}</span> <span class="text-accent-2">~/{id}</span> <span class="prompt">{cmd}</span>
    </p>
    <h2 id={`${id}-title`} class="text-3xl font-bold tracking-tight text-fg sm:text-5xl">
      <span class="text-accent">#</span>
      {title}
    </h2>
    {subtitle && <p class="mt-3 max-w-2xl text-muted">{subtitle}</p>}
  </header>
  <slot />
</section>
