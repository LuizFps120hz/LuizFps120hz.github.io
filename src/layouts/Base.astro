---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${profile.name} — ${profile.role}`,
  description = `${profile.name}'s portfolio. ${profile.tagline}`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en" class="no-js" data-theme="green">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.fullName} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07090a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Runs before paint: restore saved theme / CRT preference, mark JS as available. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('theme');
          if (t && /^(green|amber|cyan|dracula)$/.test(t)) d.dataset.theme = t;
          if (localStorage.getItem('crt') === '1') d.classList.add('crt');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="bg-grid" aria-hidden="true"></div>
    <a href="#main" class="sr-only z-50 rounded bg-accent px-3 py-2 text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
